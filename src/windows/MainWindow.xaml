<Window x:Class="AiroRobloxBuilder.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="airobloxbuilder" Width="1400" Height="860" MinWidth="1050" MinHeight="680" Background="#0b0d12" Foreground="#edf1f7">
<Grid><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="62"/></Grid.RowDefinitions>
<Border Grid.Row="0" Background="#11151d" BorderBrush="#252b36" BorderThickness="0,0,0,1" Padding="18,0"><DockPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="◈ airobloxbuilder" FontSize="20" FontWeight="SemiBold"/><Border Background="#18251f" CornerRadius="9" Padding="9,4" Margin="14,0,0,0"><TextBlock Text="native" Foreground="#79e2a7" FontSize="12"/></Border></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="● connected" Foreground="#79e2a7" Margin="0,0,14,0"/><TextBlock Text="windows • v0.1" Foreground="#7f8999"/></StackPanel></DockPanel></Border>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="255"/><ColumnDefinition Width="*"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="#0f1218" BorderBrush="#252b36" BorderThickness="0,0,1,0" Padding="16"><StackPanel><TextBlock Text="project" FontWeight="SemiBold" Foreground="#9da7b7"/><TextBlock Text="📁 my game" Margin="0,18,0,6" FontWeight="SemiBold"/><TextBlock Text="  ├─ scripts"/><TextBlock Text="  ├─ assets"/><TextBlock Text="  ├─ maps"/><TextBlock Text="  ├─ audio"/><TextBlock Text="  ├─ ui"/><TextBlock Text="  └─ tests"/><TextBlock Text="tasks" Margin="0,24,0,8" FontWeight="SemiBold" Foreground="#9da7b7"/><TextBlock Text="○ no active tasks" Foreground="#7f8999"/><TextBlock Text="commands" Margin="0,24,0,8" FontWeight="SemiBold" Foreground="#9da7b7"/><WrapPanel><Button Content="/plan" Margin="0,0,5,5" Padding="8,3"/><Button Content="/tasks" Margin="0,0,5,5" Padding="8,3"/><Button Content="/test" Margin="0,0,5,5" Padding="8,3"/><Button Content="/fix" Margin="0,0,5,5" Padding="8,3"/></WrapPanel><Border Background="#151a23" CornerRadius="8" Padding="10" Margin="0,14,0,0"><TextBlock Text="tip: describe changes naturally. the builder keeps project context." TextWrapping="Wrap" Foreground="#8f99aa" FontSize="12"/></Border><Button Content="+ new project" HorizontalAlignment="Left" Margin="0,20,0,0"/></StackPanel></Border>
<Grid Grid.Column="1" Margin="20,18"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer Grid.Row="0"><StackPanel x:Name="ChatMessages"/></ScrollViewer><Border Grid.Row="1" Background="#11151d" BorderBrush="#303744" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,14,0,0"><DockPanel><Button DockPanel.Dock="Right" Content="➤" Width="48" Click="Send_Click"/><TextBox x:Name="PromptBox" MinHeight="42" Background="Transparent" Foreground="#edf1f7" BorderThickness="0" VerticalContentAlignment="Center" Text="describe your game or tell the builder what to do..." KeyDown="PromptBox_KeyDown"/></DockPanel></Border></Grid>
<Border Grid.Column="2" Background="#0f1218" BorderBrush="#252b36" BorderThickness="1,0,0,0" Padding="16"><StackPanel><TextBlock Text="🧠 agents" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="orchestrator  ● ready" Margin="0,22,0,10"/><TextBlock Text="💻 code  ○ idle"/><TextBlock Text="🧱 world  ○ idle" Margin="0,10"/><TextBlock Text="🎨 assets  ○ idle" Margin="0,10"/><TextBlock Text="🎞 animation  ○ idle" Margin="0,10"/><TextBlock Text="🔊 audio  ○ idle" Margin="0,10"/><TextBlock Text="🧪 testing  ○ idle" Margin="0,10"/><TextBlock Text="🔧 repair  ○ idle" Margin="0,10"/><TextBlock Text="roblox studio" Margin="0,28,0,6" FontWeight="SemiBold" Foreground="#9da7b7"/><TextBlock Text="○ optional mcp bridge" Foreground="#7f8999"/><Button Content="configure mcp" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border></Grid>
<Border Grid.Row="2" Background="#11151d" BorderBrush="#252b36" BorderThickness="0,1,0,0" Padding="18,0"><DockPanel VerticalAlignment="Center"><TextBlock Text="free forever • native • windows first" Foreground="#7f8999"/><TextBlock DockPanel.Dock="Right" Text="v0.1 foundation" Foreground="#7f8999"/></DockPanel></Border></Grid></Window>