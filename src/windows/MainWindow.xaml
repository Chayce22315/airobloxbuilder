<Window x:Class="AiroRobloxBuilder.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="airobloxbuilder" Width="1440" Height="900" MinWidth="1050" MinHeight="680"
 Background="#090B10" Foreground="#F4F7FB">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#F4F7FB"/><Setter Property="Background" Value="#171C28"/>
   <Setter Property="BorderBrush" Value="#2B3344"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="12,8"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="78"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#0D1017" BorderBrush="#242B39" BorderThickness="0,0,0,1" Padding="22,0">
   <DockPanel VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal">
     <Button x:Name="ExtraButton" Content="☰" Width="42" Height="42" Padding="0" FontSize="18" Click="ExtraButton_Click" Background="#151A24"/>
     <TextBlock Text="◈" FontSize="25" Foreground="#A879FF" Margin="14,0,7,0" VerticalAlignment="Center"/>
     <TextBlock Text="my zombie mall" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Border Background="#10261C" CornerRadius="12" Padding="10,6" Margin="0,0,12,0"><TextBlock Text="● online" Foreground="#75E6A5"/></Border>
     <TextBlock Text="windows" Foreground="#7E899C" VerticalAlignment="Center"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Popup x:Name="ExtrasPopup" PlacementTarget="{Binding ElementName=ExtraButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
   <Border Background="#121722" BorderBrush="#30394A" BorderThickness="1" CornerRadius="16" Padding="10" Width="245">
    <StackPanel>
     <TextBlock Text="extras" FontSize="17" FontWeight="SemiBold" Margin="6,4,6,10"/>
     <Button Content="📁  projects" Click="ExtraProjects_Click" HorizontalContentAlignment="Left"/>
     <Button Content="📋  tasks" Click="ExtraTasks_Click" Margin="0,6,0,0" HorizontalContentAlignment="Left"/>
     <Button Content="🐙  github" Margin="0,6,0,0" HorizontalContentAlignment="Left"/>
     <Button Content="🔌  roblox studio" Margin="0,6,0,0" HorizontalContentAlignment="Left"/>
     <Button Content="🧠  model" Margin="0,6,0,0" HorizontalContentAlignment="Left"/>
     <Button Content="📦  import / export" Margin="0,6,0,0" HorizontalContentAlignment="Left"/>
     <Button Content="⚙  settings" Margin="0,6,0,0" HorizontalContentAlignment="Left"/>
    </StackPanel>
   </Border>
  </Popup>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#0C0F15" BorderBrush="#242B39" BorderThickness="0,0,1,0" Padding="22,24">
    <StackPanel>
     <TextBlock Text="project" Foreground="#8994A8" FontWeight="SemiBold"/>
     <TextBlock Text="📁 my game" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,12"/>
     <TextBlock Text="📜  scripts" Margin="0,7"/><TextBlock Text="🌎  worlds" Margin="0,7"/>
     <TextBlock Text="🧱  assets" Margin="0,7"/><TextBlock Text="🎵  audio" Margin="0,7"/>
     <TextBlock Text="🎨  ui" Margin="0,7"/><TextBlock Text="🧪  tests" Margin="0,7"/>
     <Border Background="#121722" CornerRadius="14" Padding="13" Margin="0,28,0,0">
      <StackPanel><TextBlock Text="tasks" Foreground="#8994A8" FontWeight="SemiBold"/><TextBlock Text="○ waiting for work" Foreground="#6F7A8D" Margin="0,8,0,0"/></StackPanel>
     </Border>
     <TextBlock Text="tip" Foreground="#8994A8" FontWeight="SemiBold" Margin="0,28,0,8"/>
     <TextBlock Text="describe the game naturally. airo keeps the project context between requests." TextWrapping="Wrap" Foreground="#6F7A8D" FontSize="12"/>
    </StackPanel>
   </Border>
   <Grid Grid.Column="1" Margin="34,28,34,22">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ChatMessages" MaxWidth="940" HorizontalAlignment="Center"/></ScrollViewer>
    <Border Grid.Row="1" Background="#111621" BorderBrush="#343D50" BorderThickness="1" CornerRadius="17" Padding="12" Margin="0,20,0,0" MaxWidth="940" HorizontalAlignment="Center">
     <DockPanel><Button DockPanel.Dock="Right" Content="➤" Width="52" Height="44" Click="Send_Click" Background="#7B4DFF" BorderBrush="#956FFF" FontSize="17"/>
      <TextBox x:Name="PromptBox" MinHeight="44" Background="Transparent" Foreground="#F4F7FB" BorderThickness="0" VerticalContentAlignment="Center" FontSize="15" Text="tell airo what to build..." KeyDown="PromptBox_KeyDown"/>
     </DockPanel>
    </Border>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="#0D1017" BorderBrush="#242B39" BorderThickness="0,1,0,0" Padding="22,0">
   <DockPanel VerticalAlignment="Center"><TextBlock Text="free forever • native • build anywhere" Foreground="#6F7A8D"/>
    <TextBlock DockPanel.Dock="Right" Text="ai runtime connected" Foreground="#6F7A8D"/></DockPanel>
  </Border>
 </Grid>
</Window>