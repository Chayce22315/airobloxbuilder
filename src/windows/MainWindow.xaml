<Window x:Class="AiroRobloxBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="airobloxbuilder"
        Width="1280"
        Height="760"
        MinWidth="960"
        MinHeight="600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Padding="18">
            <StackPanel>
                <TextBlock Text="◈ airobloxbuilder" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="project" Margin="0,28,0,8" FontWeight="SemiBold"/>
                <TextBlock Text="📁 my game" Margin="0,6"/>
                <TextBlock Text="  ├─ scripts" Margin="0,4"/>
                <TextBlock Text="  ├─ assets" Margin="0,4"/>
                <TextBlock Text="  ├─ maps" Margin="0,4"/>
                <TextBlock Text="  ├─ audio" Margin="0,4"/>
                <TextBlock Text="  └─ ui" Margin="0,4"/>
                <TextBlock Text="📋 tasks" Margin="0,28,0,0" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0">
                <StackPanel x:Name="ChatMessages"/>
            </ScrollViewer>
            <DockPanel Grid.Row="1" Margin="0,14,0,0">
                <Button Content="➤" Width="48" DockPanel.Dock="Right" Click="Send_Click"/>
                <TextBox x:Name="PromptBox" MinHeight="44" VerticalContentAlignment="Center"
                         Text="describe your game or tell the builder what to do..."/>
            </DockPanel>
        </Grid>

        <Border Grid.Column="2" Padding="18">
            <StackPanel>
                <TextBlock Text="🧠 agents" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="orchestrator  ○ idle" Margin="0,24,0,8"/>
                <TextBlock Text="💻 code  ○ idle" Margin="0,8"/>
                <TextBlock Text="🧱 world  ○ idle" Margin="0,8"/>
                <TextBlock Text="🎨 assets  ○ idle" Margin="0,8"/>
                <TextBlock Text="🧪 testing  ○ idle" Margin="0,8"/>
                <TextBlock Text="🔧 repair  ○ idle" Margin="0,8"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
