{
  "schema_version": 3,
  "purpose": "base-model selection and runtime adapter mapping for airobloxbuilder specialist fine-tuning on small consumer GPUs",
  "hardware_profile": {
    "gpu": "NVIDIA GeForce RTX 5060",
    "vram_gib": 8,
    "strategy": "4-bit QLoRA, one specialist adapter resident at a time",
    "max_seq_length": 2048,
    "per_device_train_batch_size": 1,
    "gradient_accumulation_steps": 32
  },
  "selection_notes": [
    "Use compact checkpoints that leave VRAM headroom for QLoRA activations and the Windows display.",
    "The default specialist base is Qwen/Qwen3.5-4B, an Apache-2.0 checkpoint suitable for task-specific fine-tuning.",
    "Specialists are separate LoRA adapters; the runtime loads one adapter at a time rather than ten models simultaneously.",
    "These are starting checkpoints, not trained airobloxbuilder models.",
    "If a future checkpoint does not fit the 8 GiB profile, replace only that specialist's model_id."
  ],
